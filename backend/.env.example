# Postgres connection string (Neon, Supabase, local, ...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/videomeet"
# Long random string used to sign auth tokens, e.g. `openssl rand -hex 32`
JWT_SECRET="change-me"
PORT=3000
# Comma-separated list of front-end origins allowed to connect
CORS_ORIGINS="http://localhost:3001,https://video-conferencing-orpin-beta.vercel.app"
# Google OAuth (https://console.cloud.google.com/apis/credentials → OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match an "Authorized redirect URI" on the OAuth client. It points at the
# front-end's /api proxy (not the backend directly) so the session cookie is first-party.
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"
# Front-end URL (defaults to the first CORS origin). An https URL makes cookies Secure.
FRONTEND_URL="http://localhost:3001"
