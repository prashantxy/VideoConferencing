# Postgres connection string (Neon, Supabase, local, ...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/videomeet"
# Long random string used to sign auth tokens, e.g. `openssl rand -hex 32`
JWT_SECRET="change-me"
PORT=3000
# Comma-separated list of front-end origins allowed to connect
CORS_ORIGINS="http://localhost:3001,https://video-conferencing-orpin-beta.vercel.app"
