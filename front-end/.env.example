# URL of the backend (Express + Socket.IO)
NEXT_PUBLIC_API_URL=http://localhost:3000
# Optional TURN server for users behind strict NATs / corporate firewalls
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
# Optional donation link (Buy Me a Coffee, Ko-fi, GitHub Sponsors, ...). Shows a Support button when set.
# NEXT_PUBLIC_SUPPORT_URL=https://buymeacoffee.com/your-name
