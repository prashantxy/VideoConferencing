# URL of the backend (Express + Socket.IO). API calls are proxied through /api to it; sockets connect directly.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Optional TURN server for users behind strict NATs / corporate firewalls
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
# Donation link for the Support button (defaults to https://buymeacoffee.com/moralizer_19)
# NEXT_PUBLIC_SUPPORT_URL=https://buymeacoffee.com/moralizer_19
